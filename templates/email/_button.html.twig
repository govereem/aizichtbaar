{# Bulletproof button: a styled table cell works in Outlook, where border-radius and padding on <a> do not #}
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:24px 0;">
    <tr>
        <td align="center" style="background-color:#1E6B3A; border-radius:8px;">
            <a href="{{ url }}" style="display:inline-block; padding:12px 24px; font-size:16px; font-weight:bold; color:#ffffff; text-decoration:none; border-radius:8px;">{{ label }}</a>
        </td>
    </tr>
</table>
