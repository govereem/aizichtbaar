{% extends 'base.html.twig' %}

{% block title %}Uitgebreide scan aanmaken — AIzichtbaar{% endblock %}

{% block body %}
<div class="max-w-xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-[#1E6B3A] mb-2">Uitgebreide scan aanmaken</h1>
    <p class="text-gray-600 mb-8">Maak gratis een uitgebreide scan aan voor een gebruiker. Er wordt geen betaling gevraagd.</p>

    {{ form_start(form, {attr: {class: 'bg-white p-8 rounded-xl shadow-sm space-y-6'}}) }}
        {{ form_row(form.user, {label_attr: {class: 'block font-medium mb-2'}, attr: {class: 'w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-[#1E6B3A] focus:outline-none'}}) }}
        {{ form_row(form.websiteUrl, {label_attr: {class: 'block font-medium mb-2'}, attr: {class: 'w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-[#1E6B3A] focus:outline-none', placeholder: 'https://jouwwebsite.nl'}}) }}

        <button type="submit" class="w-full btn-primary text-white py-3 rounded-lg font-semibold">Scan aanmaken</button>
    {{ form_end(form) }}
</div>
{% endblock %}
