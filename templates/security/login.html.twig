{% extends 'base.html.twig' %}

{% block title %}Inloggen — AIzichtbaar{% endblock %}

{% block body %}
<div class="max-w-xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-[#1E6B3A] mb-8">Inloggen</h1>

    {% if error %}
        <div class="bg-red-50 text-red-800 px-4 py-3 rounded-lg mb-6" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}" class="bg-white p-8 rounded-xl shadow-sm space-y-6">
        <div>
            <label for="username" class="block font-medium mb-2">E-mailadres</label>
            <input type="email" id="username" name="_username" value="{{ last_username }}" required autofocus autocomplete="email"
                   class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-[#1E6B3A] focus:outline-none">
        </div>

        <div>
            <label for="password" class="block font-medium mb-2">Wachtwoord</label>
            <input type="password" id="password" name="_password" required autocomplete="current-password"
                   class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-[#1E6B3A] focus:outline-none">
            <p class="mt-2 text-sm">
                <a href="{{ path('app_forgot_password_request') }}" class="text-[#1E6B3A] hover:underline">Wachtwoord vergeten?</a>
            </p>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit" class="w-full btn-primary text-white py-3 rounded-lg font-semibold">Inloggen</button>
    </form>

    <p class="mt-6 text-center text-gray-600">
        Nog geen account? <a href="{{ path('app_register') }}" class="text-[#1E6B3A] font-medium hover:underline">Registreer je hier</a>
    </p>
</div>
{% endblock %}
