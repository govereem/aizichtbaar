{% extends 'base.html.twig' %}

{% block title %}Contact — AIzichtbaar{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-[#1E6B3A] mb-8">Contact opnemen</h1>

    <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white p-8 rounded-xl shadow-sm space-y-4 text-gray-700">
            <h2 class="text-2xl font-bold text-gray-900">AIzichtbaar</h2>
            <p>Gerben Colmjonwei 109<br>8915 GJ Leeuwarden</p>
            <p>KVK-nummer: 82005222</p>
            <p>E-mail: <a href="mailto:support@aizichtbaar.nl" class="underline text-[#1E6B3A]">support@aizichtbaar.nl</a></p>
            <p class="text-sm text-gray-500">Vragen over betalen of je gegevens? Lees ook onze <a href="{{ path('app_terms') }}" class="underline">algemene voorwaarden</a>.</p>
        </div>

        <div>
            {% if limit_reached is defined and limit_reached %}
                <div class="mb-4 px-4 py-3 rounded-lg bg-red-50 text-red-800" role="alert">Je hebt het maximale aantal berichten bereikt. Probeer het later opnieuw.</div>
            {% endif %}

            {{ form_start(form, {attr: {class: 'bg-white p-8 rounded-xl shadow-sm space-y-6'}}) }}
                {{ form_row(form.name, {label: 'Naam', label_attr: {class: 'block font-medium mb-2'}, attr: {class: 'w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-[#1E6B3A] focus:outline-none'}}) }}
                {{ form_row(form.email, {label: 'E-mailadres', label_attr: {class: 'block font-medium mb-2'}, attr: {class: 'w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-[#1E6B3A] focus:outline-none'}}) }}
                {{ form_row(form.message, {label: 'Vraag of opmerking', label_attr: {class: 'block font-medium mb-2'}, attr: {class: 'w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-[#1E6B3A] focus:outline-none'}}) }}

                <button type="submit" class="w-full btn-primary text-white py-3 rounded-lg font-semibold">Verzenden</button>
                <p class="text-xs text-center text-gray-500">Je krijgt zo snel mogelijk antwoord.</p>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
