{% extends 'base.html.twig' %}

{% block title %}Nieuw wachtwoord — AIzichtbaar{% endblock %}

{% block body %}
<div class="max-w-xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-[#1E6B3A] mb-8">Nieuw wachtwoord instellen</h1>

    {{ form_start(resetForm, {attr: {class: 'bg-white p-8 rounded-xl shadow-sm space-y-6'}}) }}
        {{ form_row(resetForm.plainPassword.first, {label_attr: {class: 'block font-medium mb-2'}, attr: {class: 'w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-[#1E6B3A] focus:outline-none'}}) }}
        {{ form_row(resetForm.plainPassword.second, {label_attr: {class: 'block font-medium mb-2'}, attr: {class: 'w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-[#1E6B3A] focus:outline-none'}}) }}

        <button type="submit" class="w-full btn-primary text-white py-3 rounded-lg font-semibold">Wachtwoord opslaan</button>
    {{ form_end(resetForm) }}
</div>
{% endblock %}
