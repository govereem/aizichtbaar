{% extends 'base.html.twig' %}

{% block title %}Wachtwoord vergeten — AIzichtbaar{% endblock %}

{% block body %}
<div class="max-w-xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-[#1E6B3A] mb-4">Wachtwoord vergeten</h1>
    <p class="text-gray-600 mb-8">Vul je e-mailadres in. Dan sturen we je een link om een nieuw wachtwoord in te stellen.</p>

    {{ form_start(requestForm, {attr: {class: 'bg-white p-8 rounded-xl shadow-sm space-y-6'}}) }}
        {{ form_row(requestForm.email, {label: 'E-mailadres', label_attr: {class: 'block font-medium mb-2'}, attr: {class: 'w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-[#1E6B3A] focus:outline-none'}}) }}

        <button type="submit" class="w-full btn-primary text-white py-3 rounded-lg font-semibold">Stuur resetlink</button>
    {{ form_end(requestForm) }}
</div>
{% endblock %}
