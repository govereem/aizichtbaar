{% extends 'dashboard/layout.html.twig' %}

{% block title %}Mijn scans — AIzichtbaar{% endblock %}

{% block dashboard_content %}
    <div class="flex items-center justify-between mb-8">
        <h1 class="text-3xl font-bold text-[#1E6B3A]">Mijn scans</h1>
        <div class="flex items-center gap-2">
            <div class="inline-flex rounded-lg border bg-white overflow-hidden text-sm" role="group" aria-label="Weergave">
                <a href="{{ path('app_dashboard_scans', {view: 'grid'}) }}"
                   class="px-3 py-2 {{ 'grid' == view ? 'bg-[#1E6B3A] text-white' : 'text-gray-600 hover:bg-gray-50' }}"
                   {{ 'grid' == view ? 'aria-current="true"' : '' }}>Raster</a>
                <a href="{{ path('app_dashboard_scans', {view: 'list'}) }}"
                   class="px-3 py-2 {{ 'list' == view ? 'bg-[#1E6B3A] text-white' : 'text-gray-600 hover:bg-gray-50' }}"
                   {{ 'list' == view ? 'aria-current="true"' : '' }}>Lijst</a>
            </div>
            <a href="{{ path('app_scan') }}" class="btn-primary text-white px-4 py-2 rounded-lg font-semibold">Nieuwe scan</a>
        </div>
    </div>

    {% if scans is empty %}
        <div class="bg-white p-8 rounded-xl shadow-sm text-center text-gray-600">
            Je hebt nog geen scans. Start je eerste scan om te zien hoe zichtbaar je website is voor AI.
        </div>
    {% elseif 'list' == view %}
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
            <table class="min-w-full text-sm">
                <thead class="bg-gray-50 text-left text-gray-500">
                    <tr>
                        <th class="px-4 py-3 font-medium">Website</th>
                        <th class="px-4 py-3 font-medium">Datum</th>
                        <th class="px-4 py-3 font-medium">Type</th>
                        <th class="px-4 py-3 font-medium">Status</th>
                        <th class="px-4 py-3 font-medium">Score</th>
                        <th class="px-4 py-3"></th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    {% for scan in scans %}
                        <tr>
                            <td class="px-4 py-3 font-semibold truncate max-w-xs">{{ scan.websiteUrl }}</td>
                            <td class="px-4 py-3 text-gray-500 whitespace-nowrap">{{ scan.createdAt|date('d-m-Y H:i') }}</td>
                            <td class="px-4 py-3">{{ scan.type == 'paid' ? 'Uitgebreid' : 'Gratis' }}</td>
                            <td class="px-4 py-3">{% include 'dashboard/_status.html.twig' with {status: scan.status} only %}</td>
                            <td class="px-4 py-3">{{ scan.results.score ?? '—' }}</td>
                            <td class="px-4 py-3">
                                <div class="flex items-center justify-end gap-4 whitespace-nowrap">
                                    {% include 'dashboard/_rescan_form.html.twig' %}
                                    <a href="{{ path('app_scan_result', {publicId: scan.publicId}) }}" class="text-[#1E6B3A] font-medium hover:underline">Bekijk</a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-4">
            {% for scan in scans %}
                <div class="bg-white rounded-xl shadow-sm p-6 flex flex-col">
                    <div class="flex items-start justify-between gap-2 mb-2">
                        <p class="font-semibold truncate">{{ scan.websiteUrl }}</p>
                        <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded-full shrink-0">{{ scan.type == 'paid' ? 'Uitgebreid' : 'Gratis' }}</span>
                    </div>
                    <p class="text-sm text-gray-500 mb-4">{{ scan.createdAt|date('d-m-Y H:i') }}</p>
                    <div class="flex items-end justify-between mt-auto">
                        <div>
                            <div class="text-3xl font-bold text-[#1E6B3A]">{{ scan.results.score ?? '—' }}</div>
                            <div class="text-sm text-gray-500">{% include 'dashboard/_status.html.twig' with {status: scan.status} only %}</div>
                        </div>
                        <div class="flex flex-col items-end gap-2 text-sm">
                            <a href="{{ path('app_scan_result', {publicId: scan.publicId}) }}" class="text-[#1E6B3A] font-medium hover:underline">Bekijk</a>
                            {% include 'dashboard/_rescan_form.html.twig' %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
