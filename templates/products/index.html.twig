{% extends 'base.html.twig' %}

{% block title %}AI Zichtbaarheid Scan — AIzichtbaar{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-center mb-4 text-[#1E6B3A]">Word je gevonden door ChatGPT, Perplexity en Google AI?</h1>
    <p class="text-center text-lg text-gray-600 mb-12">Ontdek in een paar minuten of AI-assistenten jouw website kunnen vinden en citeren, en wat je kunt verbeteren.</p>

    <div class="grid md:grid-cols-2 gap-8">
        <div class="border rounded-xl p-8 bg-white shadow-sm">
            <h2 class="text-2xl font-bold mb-3">Gratis Scan</h2>
            <p class="text-3xl font-bold text-[#1E6B3A] mb-4">€0</p>
            <ul class="space-y-2 mb-6 text-gray-700">
                <li>✓ Score op AI-zichtbaarheid van 0 tot 100</li>
                <li>✓ 7 controles, zoals AI-crawlers, structured data en llms.txt</li>
                <li>✓ Actieplan met wat slim is om aan te passen</li>
                <li>✓ Kant-en-klare llms.txt, JSON-LD en robots.txt</li>
            </ul>
            <a href="{{ path('app_scan_free') }}" class="block text-center btn-primary text-white py-3 rounded-lg font-semibold">Start gratis scan</a>
            <p class="text-center text-xs text-gray-500 mt-2">Geen account nodig.</p>
        </div>

        {% if scan_paid_enabled %}
        <div class="border-2 border-[#1E6B3A] rounded-xl p-8 bg-white shadow-md relative">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[#1E6B3A] text-white text-xs px-3 py-1 rounded-full">Aanbevolen</div>
            <h2 class="text-2xl font-bold mb-3">Uitgebreide Scan</h2>
            <p class="text-3xl font-bold text-[#1E6B3A] mb-4">€49</p>
            <ul class="space-y-2 mb-6 text-gray-700">
                <li>✓ Alles van de gratis scan</li>
                <li>✓ AI-antwoordsimulatie: wordt je geciteerd?</li>
                <li>✓ Uitleg per stap: waarom, hoe, en hoeveel werk</li>
                <li>✓ Vergelijking met maximaal 3 concurrenten</li>
                <li>✓ Voorbeeldteksten die AI-assistenten graag overnemen</li>
                <li>✓ Bestanden voor je hele site en een rapport per e-mail</li>
            </ul>
            <a href="{{ path('app_scan_paid') }}" class="block text-center btn-primary text-white py-3 rounded-lg font-semibold">Koop uitgebreide scan</a>
        </div>
        {% endif %}
    </div>

    <div class="grid md:grid-cols-3 gap-6 text-center mt-16">
        <div>
            <div class="text-2xl font-bold text-[#1E6B3A] mb-2">1</div>
            <p class="font-semibold mb-1">Vul je website in</p>
            <p class="text-sm text-gray-600">Alleen de URL van je homepage. Geen account nodig voor de gratis scan.</p>
        </div>
        <div>
            <div class="text-2xl font-bold text-[#1E6B3A] mb-2">2</div>
            <p class="font-semibold mb-1">Wij controleren je site</p>
            <p class="text-sm text-gray-600">We kijken naar de signalen die AI-systemen gebruiken om een website te begrijpen.</p>
        </div>
        <div>
            <div class="text-2xl font-bold text-[#1E6B3A] mb-2">3</div>
            <p class="font-semibold mb-1">Krijg je score en plan</p>
            <p class="text-sm text-gray-600">Je resultaat staat direct op je eigen pagina, met de stappen die je kunt zetten.</p>
        </div>
    </div>
</div>
{% endblock %}
